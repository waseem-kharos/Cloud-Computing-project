# ---------------------------------------------------------------------------
# MediQueue backend environment
# Copy to .env and change SECRET_KEY before sharing this project.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
API_PREFIX=/api

# Local demo database (no server required):
DATABASE_URL=sqlite:///./hospital.db

# PostgreSQL alternative (after installing Postgres or starting docker compose):
# DATABASE_URL=postgresql+psycopg://mediqueue:mediqueue@localhost:5432/mediqueue
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/mediqueue

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-development-secret-key-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cookie behaviour. Keep SECURE=false for local HTTP demos.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated or JSON list. Vite proxy makes the default dev setup same-origin.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# Create missing tables on startup for local development. Use Alembic in production.
AUTO_CREATE_TABLES=true

# Booking rules
BOOKING_HORIZON_DAYS=60
QUEUE_POLL_SECONDS=15

# Seed demo credentials are printed by `python -m app.seed`.
